# PulseCare Environment Configuration Example

# Project & Env
PROJECT_NAME="PulseCare - Smart Healthcare Appointment & Triage System"
ENVIRONMENT="development"

# Database
# For PostgreSQL with pgvector:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/pulsecare"
# SYNC_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pulsecare"
# For zero-dependency local / testing:
DATABASE_URL="sqlite+aiosqlite:///./pulsecare.db"
SYNC_DATABASE_URL="sqlite:///./pulsecare.db"

# Security
SECRET_KEY="pulsecare-production-secret-key-change-in-env-32-chars-min"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Provider Configuration
# Options: mock | gemini | openai
LLM_PROVIDER="mock"
LLM_MODEL="gemini-3.8-flash"
# LLM_API_KEY is used by Gemini and OpenAI. GEMINI_API_KEY is accepted as a
# legacy alias when LLM_API_KEY is unset or blank.
LLM_API_KEY=""
LLM_BASE_URL=""
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=30

# Embeddings & Reranker
# Options: mock | openai | gemini | huggingface
EMBEDDING_PROVIDER="mock"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSION=384

# Options: simple | cross-encoder | cohere
RERANKER_PROVIDER="simple"
RERANKER_MODEL="cross-encoder/ms-marco-MiniLM-L-6-v2"

# Feature Flags
FEATURE_PROPOSE_BOOKING=true
FEATURE_EXTERNAL_MEDICINE_API=true

# Rate Limiting
CHAT_RATE_LIMIT_PER_MINUTE=30
CHAT_MAX_INPUT_LENGTH=1500

# Optional knowledge source configuration. Map canonical CSV fields to the
# actual supplied headers; no CSV headers are assumed by the application.
CHATBOT_CSV_SOURCES_JSON="[]"
PULSECARE_KNOWLEDGE_FILES_JSON='["knowledge_base/pulsecare_faq.md", "knowledge_base/pulsecare_features.md", "knowledge_base/pulsecare_policies.md"]'
MEDICAL_KNOWLEDGE_FILES_JSON='["knowledge_base/medical_guidelines.md"]'
